rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // Merge this one namespace into existing rules. Do NOT replace your old matches.
  match /hsFootballV1/app {
   function signed() { return request.auth != null; }
   match /coaches/{uid}/saves/{saveId} {
    allow read, write: if signed() && request.auth.uid == uid;
   }
   match /games/{code} {
    function member() { return signed() && request.auth.uid in resource.data.members; }
    // Account access and one committed sequence protect reliability.
    // The client locks roster/tendencies; rules avoid expensive whole-roster comparisons.
    function validTurn() {
     return member() && resource.data.status == 'active' && resource.data.turn == request.auth.uid
      && request.resource.data.seq == resource.data.seq + 1
      && request.resource.data.game.seq == request.resource.data.seq
      && request.resource.data.members == resource.data.members
      && request.resource.data.version == resource.data.version
      && request.resource.data.turn == resource.data.members[request.resource.data.game.possession]
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['game','seq','turn','status','updated']);
    }
    allow get: if signed();
    allow list: if signed() && (request.auth.uid in resource.data.members || resource.data.status == 'complete');
    allow create: if signed() && request.resource.data.members == [request.auth.uid]
     && request.resource.data.status == 'waiting' && request.resource.data.seq == 0
     && request.resource.data.version == 'hsf-1.2.0';
    allow update: if signed() && (validTurn() || (
     resource.data.status == 'waiting' && resource.data.members.size() == 1
     && !(request.auth.uid in resource.data.members)
     && request.resource.data.members == resource.data.members.concat([request.auth.uid])
     && request.resource.data.status == 'active' && request.resource.data.seq == 0
     && request.resource.data.version == resource.data.version
     && request.resource.data.game.seq == 0
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','names','books','status','turn','game','updated'])
    ));
    allow delete: if false;
    match /snaps/{seq} {
     function parent() { return get(/databases/$(database)/documents/hsFootballV1/app/games/$(code)); }
     allow read: if signed() && request.auth.uid in parent().data.members;
     allow create: if signed() && request.auth.uid in parent().data.members
      && parent().data.turn == request.auth.uid && parent().data.status == 'active'
      && request.resource.data.actor == request.auth.uid
      && request.resource.data.payload is string && request.resource.data.payload.size() < 850000;
     allow update, delete: if false;
    }
   }
  }
 }
}
